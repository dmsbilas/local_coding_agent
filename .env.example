# AI Doer — https://ai-doer.com (Integrations → create API key)
AI_DOER_API_KEY=aiob_your_key_here
AI_DOER_BASE_URL=https://ai-doer.com/v1/api
MODEL_NAME=gpt-4o

# Which agent main.py loads: react_ai_doer | react_ollama | basic
AGENT=react_ai_doer

# Local Ollama (agents.basic / agents.react_ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5-coder:7b

# Where generated projects are written (relative to repo root)
SANDBOX_DIR=sandbox

# Agent limits (optional)
PLAN_MODE=reactive
MAX_REVISIONS=6
MAX_STEPS=12
MAX_TOOL_RETRIES=3
MAX_VALIDATOR_ATTEMPTS=2
MAX_REPEATED_ACTIONS=3
LLM_TIMEOUT_SECONDS=120
